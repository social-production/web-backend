# Database
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/social_production

# JWT
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-only-change-me
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=30

# Message encryption (Fernet key)
# Generate a unique key and keep it out of git:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MESSAGE_ENCRYPTION_KEY=

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_SOCKET_TIMEOUT_SECONDS=2
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=2
REDIS_MAX_CONNECTIONS=50
REDIS_CACHE_TTL_SECONDS=3600

# CORS — comma-separated origins. Production must use explicit origins.
CORS_ORIGINS=http://localhost:5173

# Signup. false refuses POST /auth/register immediately (restart the API to apply).
SIGNUP_ENABLED=true
# Cloudflare Turnstile secret. Leave empty locally so signup works without a captcha.
TURNSTILE_SECRET_KEY=

# Governance warm-up. Leave at 0 while prototyping. Raise both to stop fresh accounts
# from voting, filling quorum, or volunteering as a moderator.
# GOVERNANCE_MIN_ACCOUNT_AGE_HOURS=24
# GOVERNANCE_MIN_MEANINGFUL_ACTIONS=3
# GOVERNANCE_REMOVAL_PENALTY_HOURS=168
# GOVERNANCE_MEANINGFUL_ACTION_TYPES=create-comment,create-post,create-thread,create-help-request,create-project,create-event,submit-project-plan,submit-event-plan,create-platform-feedback

# Sybil attack. Loaded from .env, then .env.local (later file wins). Restart the API after changes.
# The ratio switch stays off until GOVERNANCE_TRUST_RATIO_ENABLED=true.
# real_r is display-only. Stances, votes, quorum, and activity bands use effective_r.
GOVERNANCE_TRUST_RATIO_ENABLED=false
GOVERNANCE_MIN_BOT_MARKS=3
GOVERNANCE_MARK_LICENSE_VOUCHES=5
GOVERNANCE_VOTE_THRESHOLD=0.66
GOVERNANCE_LIMITED_THRESHOLD=0.30
GOVERNANCE_INERT_THRESHOLD=0.10
GOVERNANCE_BOOTSTRAP_MARKERS=10
GOVERNANCE_BOOTSTRAP_TARGET=20

# GitHub feedback — required for POST /feedback (create a fine-grained PAT with Issues: write)
GITHUB_TOKEN=
GITHUB_REPO=social-production/web
