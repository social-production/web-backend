# Production environment template — copy to .env.production and fill in strong secrets.
APP_ENV=production

# Required secrets (generate unique values for each deployment)
JWT_SECRET=
MESSAGE_ENCRYPTION_KEY=
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Database (overridden by docker-compose.prod.yml service wiring)
POSTGRES_DB=social_production
POSTGRES_USER=postgres
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@postgres:5432/social_production

# Redis (overridden by docker-compose.prod.yml)
REDIS_URL=redis://:CHANGE_ME@redis:6379/0
REDIS_SOCKET_TIMEOUT_SECONDS=2
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=2
REDIS_MAX_CONNECTIONS=50
REDIS_CACHE_TTL_SECONDS=3600

# Comma-separated explicit origins — never use * in production
CORS_ORIGINS=https://your-domain.example

# Signup and bot protection
SIGNUP_ENABLED=true
TURNSTILE_SECRET_KEY=

# Governance warm-up. 0 disables the check. Recommended once the site is public:
# GOVERNANCE_MIN_ACCOUNT_AGE_HOURS=24
# GOVERNANCE_MIN_MEANINGFUL_ACTIONS=3
# GOVERNANCE_REMOVAL_PENALTY_HOURS=168
GOVERNANCE_MIN_ACCOUNT_AGE_HOURS=0
GOVERNANCE_MIN_MEANINGFUL_ACTIONS=0
GOVERNANCE_REMOVAL_PENALTY_HOURS=0

# Sybil attack. Leave the ratio switch false until the trust graph should gate votes.
GOVERNANCE_TRUST_RATIO_ENABLED=false
GOVERNANCE_MIN_BOT_MARKS=3
GOVERNANCE_MARK_LICENSE_VOUCHES=5
GOVERNANCE_VOTE_THRESHOLD=0.66
GOVERNANCE_LIMITED_THRESHOLD=0.30
GOVERNANCE_INERT_THRESHOLD=0.10
GOVERNANCE_BOOTSTRAP_MARKERS=10
GOVERNANCE_BOOTSTRAP_TARGET=20

# Optional GitHub feedback integration
GITHUB_TOKEN=
GITHUB_REPO=social-production/web

# Host port published for the API container (reverse proxy may bind elsewhere)
API_PORT=8000
